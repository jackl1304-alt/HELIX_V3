# ============================================================================
# HELIX - Full environment variable reference (Cloudflare-aware, Netcup host)
#
# Copy this file to .env (gitignored) and fill in values per environment.
# ============================================================================

# Server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://helix_user:CHANGE_ME@postgres:5432/helix_regulatory?sslmode=disable
POSTGRES_USER=helix_user
POSTGRES_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379

# Trust proxy / reverse proxy
# Behind Cloudflare: keep default CF CIDR list; matches nginx real_ip_header.
# DEV only: "true" (insecure). "false" / "1" / comma-separated CIDRs all supported.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.192.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
# CLOUDFLARE_PROXY=true  # (informational only; trust proxy is set directly via TRUSTED_PROXIES env)

# CORS allowlist (comma-separated, * = subdomain wildcard, e.g. https://*.deltaways.de)
ALLOWED_ORIGINS=https://helix.deltaways.de,https://regulatory.deltaways.de,https://*.deltaways.de

# AI / LLM provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_VERTEX_PROJECT_ID=
OPENROUTER_API_KEY=

# Regulatory source API keys (subset)
FDA_API_KEY=
EMA_API_KEY=
MHRA_API_KEY=
GRIP_USERNAME=
GRIP_PASSWORD=

# Scheduling
REG_AUTO_ENABLED=true

# Sessions - 64-byte random hex
SESSION_SECRET=

# Observability
SENTRY_DSN=
GRAFANA_PASSWORD=

# Logging
LOG_LEVEL=info

# Auto-seed regulator sources (0 in prod, 1 in dev)
AUTO_SEED=0

# ============================================================================
# Backup operations (scripts/cf-backup-offsite.sh)
# All values default sensibly if unset; ship these explicitly in .env to
# avoid silent fallback to ephemeral passphrases or undetected alert failures.
# ============================================================================

# Passphrase for symmetric backup encryption (age or openssl AES-256-GCM).
# MUST be set in production — script Warns and generates random key if unset.
BACKUP_PASSPHRASE=

# PagerDuty Events API v2 routing key. Required if BACKUP_ALERT_WEBHOOK is a
# PagerDuty URL; otherwise the alert payload is rejected by PD API.
# https://support.pagerduty.com/docs/events-api-v2
PD_ROUTING_KEY=

# Optional: directory for local backup retention (default /var/backups/helix)
BACKUP_DIR=/var/backups/helix
# Optional: how many encrypted dumps to keep locally (default 3)
KEEP_LOCAL=3
# Optional: how many encrypted dumps to keep on the remote (default 30)
KEEP_REMOTE=30
# Optional: gzip -1..-9 (default 6 — good speed/ratio balance)
GZIP_LEVEL=6
# Optional: round-trip fails if decrypted dump has fewer than this many lines
# (default 500 — HELIX schema has 90+ regulator sources + multi-tenant tables)
BELOW_THRESHOLD_LINES=500

# Failure notifier URL. Format auto-detected from URL substring:
#   hooks.slack.com       → Slack incoming webhook
#   events.pagerduty.com  → PagerDuty Events API v2
#   healthchecks.io       → GET ping to /fail path
#   anything else         → generic JSON envelope {level, run, msg, ts}
# Override auto-detection with BACKUP_ALERT_FORMAT=slack|pagerduty|healthchecks|generic
BACKUP_ALERT_WEBHOOK=
# BACKUP_ALERT_FORMAT=slack

# rclone remote + path prefix for offsite uploads (Cloudflare R2 / AWS S3).
# rclone config holds the credentials; this file only references the remote name.
RCLONE_REMOTE=helix-r2
RCLONE_PATH=backups/db
